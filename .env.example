# Local development talks to a MariaDB on port 3307.
# Docker Compose overrides DATABASE_URL so the app uses the database in the compose file.
DATABASE_URL=mysql://budget:budget-local@127.0.0.1:3307/budget

# Used by Docker Compose for the MariaDB container. Change these before the first start on the Pi.
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# Signs the login cookie. Use a long random value.
JWT_SECRET=change-me-to-a-long-random-string

# Created on first start if that email does not exist yet. Changing this later does not reset the password.
ADMIN_EMAIL=rene@rene-unternaehrer.ch
ADMIN_INITIAL_PASSWORD=replace-this-before-first-start

# Address users open in the browser. Password-reset links use it.
APP_URL=http://localhost:8080
PORT=3001

# Set COOKIE_SECURE=1 only when the site is served over HTTPS.
COOKIE_SECURE=0

# Optional. Without these, an administrator can still set a new password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
